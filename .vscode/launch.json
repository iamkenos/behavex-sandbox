      "cwd": "${workspaceFolder}",
      "args": [
        "-t",
        "one",
        "--format",
        "null",
        "--logging-level",
        "INFO",
        "--no-capture",
        "--no-logcapture",
        "features/set-1/example-tags-1.feature"
      ],
      "justMyCode": false
    },
    {
